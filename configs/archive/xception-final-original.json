{
  "raw_root": "data/raw",
  "weights": "weights/xception_imagenet.safetensors",
  "official_splits": "data/splits/ffpp_official",
  "identity_registry": null,
  "identity_policy": "source-parent",
  "seed": 42,
  "preprocessing": {
    "crop_anchor": "center",
    "multi_margin": [
      1.5
    ],
    "detector_backend": "mtcnn",
    "version": "square299_bicubic224_mtcnn50_v2",
    "master_size": 299,
    "margin_factor": 1.5,
    "confidence": 0.95,
    "min_face_size": 50,
    "interpolation": "bicubic",
    "max_pixels": 8000000,
    "max_faces": 10,
    "alignment": "landmark",
    "detector": {
      "image_size": 299,
      "margin": 0,
      "min_face_size": 50,
      "thresholds": [
        0.6,
        0.7,
        0.7
      ],
      "factor": 0.709,
      "post_process": false,
      "select_largest": true,
      "selection_method": "largest",
      "keep_all": true
    }
  },
  "model": {
    "name": "legacy_xception.tf_in1k",
    "pretrained_source": "imagenet",
    "input_size": 299,
    "mean": [
      0.5,
      0.5,
      0.5
    ],
    "std": [
      0.5,
      0.5,
      0.5
    ],
    "class_map": {
      "fake": 0,
      "real": 1
    },
    "dropout": 0.35,
    "use_cbam": true,
    "cbam_reduction": 16,
    "head_hidden": 512,
    "classifier_dropout": 0.35,
    "classifier_activation": "gelu",
    "drop_path": 0.1,
    "stochastic_depth_schedule": "linear",
    "use_frequency": true,
    "frequency_features": 128,
    "use_se": false,
    "use_eca": false,
    "use_gabor": false,
    "use_dual_stream": false,
    "use_multi_branch": false,
    "use_cross_attention": false,
    "use_fpn": false,
    "use_auxiliary_classifier": false,
    "use_multi_head": false,
    "use_attention_pooling": false,
    "use_layernorm": false,
    "use_weight_standardization": false,
    "activation": "gelu"
  },
  "training": {
    "batch_size": 4,
    "accumulation": 8,
    "workers": 4,
    "pin_memory": true,
    "amp": true,
    "epoch_samples": 60000,
    "head_epochs": 2,
    "finetune_epochs": 18,
    "head_lr": 0.001,
    "backbone_lr": 2e-05,
    "finetune_head_lr": 0.0003,
    "weight_decay": 0.0005,
    "regularization_l1": 0.0,
    "layer_warmup_epochs": 0,
    "cascade_epochs_per_stage": 1,
    "knowledge_distillation": false,
    "teacher_run": null,
    "progressive_resizing": false,
    "progressive_sizes": [
      224,
      256,
      299
    ],
    "progressive_interval": 6,
    "distillation_temperature": 4.0,
    "distillation_alpha": 0.5,
    "regularization_l2": 0.0,
    "use_adversarial": false,
    "use_weight_noise": false,
    "use_weight_averaging": false,
    "weight_average_window": 5,
    "weight_noise_std": 0.01,
    "adversarial_method": "fgsm",
    "adversarial_eps": 0.01,
    "adversarial_alpha": 0.002,
    "adversarial_steps": 3,
    "adversarial_weight": 1.0,
    "min_lr": 1e-07,
    "warmup_epochs": 3,
    "patience": 8,
    "clip_norm": 1.0,
    "loss": "label_smoothing_bce",
    "label_smoothing": 0.05,
    "focal_alpha": 0.25,
    "focal_gamma": 2.0,
    "freeze_bn": true,
    "augmentation": "robust_v2",
    "mixup_alpha": 0.2,
    "cutmix_alpha": 0.0,
    "fouriermix_prob": 0.3,
    "fouriermix_alpha": 0.1,
    "fft_amplitude_mix_prob": 0.0,
    "fft_amplitude_mix_alpha": 0.5,
    "dct_mask_prob": 0.0,
    "dct_num_masks": 8,
    "dct_mask_size": 8,
    "coarse_dropout_prob": 0.15,
    "coarse_dropout_holes": 4,
    "coarse_dropout_ratio": 0.2,
    "grid_shuffle_prob": 0.0,
    "grid_shuffle_size": 4,
    "crop_pad_prob": 0.0,
    "crop_pad_ratio": 0.9,
    "gaussian_noise_std": 0.02,
    "salt_pepper_prob": 0.0,
    "jpeg_quality_range": [
      30,
      100
    ],
    "jpeg_prob": 0.5,
    "rescale_prob": 0.3,
    "rotation_range": 10,
    "hue_jitter": 0.05,
    "saturation_jitter": 0.15,
    "color_jitter_prob": 0.3,
    "gamma_prob": 0.3,
    "blur_prob": 0.1,
    "gamma_range": [
      0.8,
      1.2
    ],
    "blur_sigma_range": [
      0.1,
      1.5
    ],
    "rescale_range": [
      0.5,
      1.0
    ],
    "random_erase_prob": 0.1,
    "grayscale_prob": 0.05,
    "sharpen_prob": 0.15,
    "sharpen_factor_range": [
      0.5,
      2.0
    ],
    "perspective_prob": 0.1,
    "perspective_scale": 0.05,
    "elastic_prob": 0.0,
    "elastic_alpha": 1.0,
    "elastic_sigma": 0.05,
    "motion_blur_prob": 0.05,
    "motion_blur_kernel": 5,
    "randaugment": false,
    "randaugment_num_ops": 2,
    "randaugment_magnitude": 9,
    "trivialaugment": false,
    "trivialaugment_bins": 31,
    "augmix": false,
    "augmix_width": 3,
    "augmix_depth": 3,
    "augmix_alpha": 1.0,
    "style_transfer": false,
    "style_images_path": null,
    "style_weights_path": null,
    "artifact_injection": false,
    "artifact_label_policy": null,
    "artifact_prob": 0.05,
    "ema_decay": 0.999,
    "use_ema": true,
    "use_swa": true,
    "swa_start_epoch": 15,
    "use_gradient_noise": false,
    "gradient_noise_std": 0.01,
    "unfreeze_schedule": "gradual",
    "layer_lr_decay": 0.85,
    "optimizer": "adamw",
    "optimizer_betas": [
      0.9,
      0.999
    ],
    "optimizer_eps": 1e-08,
    "momentum": 0.9,
    "scheduler": "cosine",
    "scheduler_warm_restarts": false,
    "scheduler_cycle_length": 10,
    "scheduler_restart_mult": 2,
    "scheduler_step_gamma": 0.1,
    "scheduler_power": 2.0,
    "scheduler_factor": 0.5,
    "scheduler_patience": 2,
    "use_sam": false,
    "sam_adaptive": false,
    "sam_rho": 0.05,
    "use_lookahead": false,
    "lookahead_k": 5,
    "lookahead_alpha": 0.5,
    "use_lion": false,
    "use_swa_final_bn_update": true,
    "auxiliary_loss_weight": 0.1,
    "consistency_loss_weight": 0.0,
    "domain_adaptation_weight": 0.0,
    "frequency_loss_weight": 0.0,
    "supcon_temperature": 0.1,
    "mixup_aware_loss": true,
    "sbi_prob": 0.0,
    "amp_dtype": "float16"
  },
  "extraction": {
    "train_real": 50,
    "train_fake": 10,
    "eval_real": 15,
    "eval_fake": 5,
    "dfd_frames": 20,
    "dfd_real_clips": 200,
    "dfd_fake_clips": 200,
    "retry_max_frames_in_memory": 8,
    "retry_max_pixels_per_frame": 4000000,
    "retry_frame_memory_budget_mb": 512,
    "train_caps": {
      "ffpp": 60000,
      "celebdf": 40000
    }
  },
  "inference": {
    "tta_hflip": true,
    "tta_vflip": true,
    "tta_multi_crop": true,
    "tta_multi_scale": [
      224,
      256,
      299
    ],
    "tta_rotation": [
      0,
      5,
      -5
    ],
    "tta_color_jitter": false,
    "calibration_method": "platt",
    "use_mc_dropout": false,
    "mc_dropout_samples": 20,
    "ensemble_weights": {
      "xception": 0.7,
      "b0": 0.3
    },
    "threshold_search": "max_fake_recall_at_5pct_fpr"
