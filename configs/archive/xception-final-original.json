  "pretraining": {
    "self_supervised": false,
    "source": "imagenet",
    "vggface2_weights_path": null,
    "ms1m_weights_path": null,
    "webface_weights_path": null,
    "progressive_resizing": false,
    "pretrain_synthetic": false,
    "knowledge_distillation": false,
    "teacher_run": null
  },
  "domain_adaptation": {
    "method": "none",
    "grl_lambda": 0.1,
    "mmd_kernel": "rbf",
    "coral_weight": 0.0,
    "few_shot_anchor_size": 50,
    "test_time_adaptation": false
  },
  "evaluation": {
    "compute_auc": true,
    "compute_pr_auc": true,
    "compute_ece": true,
    "compute_brier": true,
    "compute_recall_at_fpr": [
      0.01,
      0.05,
      0.1
