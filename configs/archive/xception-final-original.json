    "compute_cluster_ci": true,
    "compute_per_method": true,
    "compute_per_demographic": false,
    "compute_adversarial": false,
    "compute_fairness": false,
    "save_failure_cases": true,
    "compute_significance": true,
    "save_learning_curves": true,
    "save_roc_pr_reliability": true,
    "save_confusion_matrix": true
