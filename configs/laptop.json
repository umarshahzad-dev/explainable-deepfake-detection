{
  "raw_root": "data/raw",
  "weights": "weights/xception_imagenet.safetensors",
  "official_splits": "data/splits/ffpp_official",
  "identity_policy": "source-parent",
  "seed": 42,
  "model": {
    "name": "legacy_xception.tf_in1k",
    "input_size": 299,
    "mean": [
      0.5,
      0.5,
      0.5
    ],
    "std": [
      0.5,
      0.5,
      0.5
    ],
    "class_map": {
      "fake": 0,
      "real": 1
    },
    "dropout": 0.2
  },
  "training": {
    "batch_size": 8,
    "accumulation": 4,
    "workers": 4,
    "epoch_samples": 40000,
    "backbone_lr": 5e-05,
    "weight_decay": 0.0002,
    "warmup_epochs": 2
  }
}
